# ─── Meta / WhatsApp ───────────────────────────────────────────────────────────
# Token de acceso temporal o permanente de tu app en developers.facebook.com
WHATSAPP_TOKEN=EAAxxxxxxxxxxxxxxxx

# ID del número de teléfono de WhatsApp Business
# Lo encuentras en: Meta for Developers → Tu App → WhatsApp → API Setup
WHATSAPP_PHONE_ID=1234567890123456

# Token secreto que TÚ inventas para verificar el webhook (cualquier texto)
# Ejemplo: mi_token_secreto_2024
VERIFY_TOKEN=mi_token_secreto_aqui

# ─── Anthropic / Claude ────────────────────────────────────────────────────────
# Obtén tu key en: https://console.anthropic.com
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxx
